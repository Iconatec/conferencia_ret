    def selecionar_pasta_pdfs(self) -> None:
        pasta = filedialog.askdirectory(
            title="Selecione a pasta dos PDFs",
            initialdir=self.pasta_pdfs.get() or str(Path.home()),
        )
        if pasta:
            self.pasta_pdfs.set(pasta)
            self.resultado.set("")
            self.botao_abrir.configure(state="disabled")

    def selecionar_pasta_excel(self) -> None:
        pasta = filedialog.askdirectory(
            title="Selecione a pasta do arquivo Excel Apuracao-RET",
            initialdir=self.pasta_excel.get() or str(Path.home()),
        )
        if pasta:
            self.pasta_excel.set(pasta)
            self.resultado.set("")
            self.botao_abrir.configure(state="disabled")

    def iniciar_processamento(self) -> None:
        pasta_pdfs = Path(self.pasta_pdfs.get().strip())
        pasta_excel = Path(self.pasta_excel.get().strip())

        if not pasta_pdfs.is_dir():
            messagebox.showerror("Pasta invalida", "Selecione uma pasta valida de PDFs.")
            return

        if not pasta_excel.is_dir():
            messagebox.showerror(
                "Pasta invalida",
                "Selecione uma pasta valida para o arquivo Excel.",
            )
            return

        self.botao_processar.configure(state="disabled")
        self.botao_selecionar_pdfs.configure(state="disabled")
        self.botao_selecionar_excel.configure(state="disabled")
        self.botao_abrir.configure(state="disabled")
        self.resultado.set("")
        self.progresso["value"] = 0
        self.percentual.set("0%")
        self.status.set("Preparando processamento...")

        thread = threading.Thread(
            target=self.processar_guias,
            args=(pasta_pdfs, pasta_excel),
            daemon=True,
        )
        thread.start()

    def atualizar_progresso(self, atual: int, total: int, nome_arquivo: str) -> None:
        percentual = int((atual / total) * 100) if total else 0
        self.progresso["maximum"] = max(total, 1)
        self.progresso["value"] = atual
        self.percentual.set(f"{percentual}%")
        self.status.set(f"Processando {atual} de {total}: {nome_arquivo}")
        self.raiz.update_idletasks()

    def processar_guias(self, pasta_pdfs: Path, pasta_excel: Path) -> None:
        try:
            def callback(atual: int, total: int, nome: str) -> None:
                self.raiz.after(
                    0,
                    lambda: self.atualizar_progresso(atual, total, nome),
                )

            self.raiz.after(0, lambda: self.status.set("Lendo PDFs e planilha..."))
            caminho_saida, total = executar_com_progresso(
                pasta_pdfs,
                pasta_excel,
                callback,
            )
            self.arquivo_saida = caminho_saida

            self.raiz.after(0, lambda: self.finalizar_sucesso(total))

        except Exception as erro:
            self.raiz.after(0, lambda: self.finalizar_erro(str(erro)))

    def finalizar_sucesso(self, total: int) -> None:
        self.progresso["value"] = self.progresso["maximum"]
        self.percentual.set("100%")
        self.status.set("Processamento concluido.")
        self.resultado.set(
            f"Concluido: {total} arquivo(s) processado(s).\n"
            f"Planilha criada: {self.arquivo_saida}"
        )
        self.botao_processar.configure(state="normal")
        self.botao_selecionar_pdfs.configure(state="normal")
        self.botao_selecionar_excel.configure(state="normal")
        self.botao_abrir.configure(state="normal")

        messagebox.showinfo(
            "Processamento concluido",
            f"{total} arquivo(s) processado(s).\n\n"
            f"Planilha criada com sucesso em:\n{self.arquivo_saida}",
        )

    def finalizar_erro(self, mensagem: str) -> None:
        self.status.set("Processamento nao concluido.")
        self.resultado.set(f"Erro: {mensagem}")
        self.botao_processar.configure(state="normal")
        self.botao_selecionar_pdfs.configure(state="normal")
        self.botao_selecionar_excel.configure(state="normal")
        self.botao_abrir.configure(state="disabled")
        messagebox.showerror("Erro no processamento", mensagem)

    def abrir_planilha(self) -> None:
        if self.arquivo_saida and self.arquivo_saida.exists():
            os.startfile(self.arquivo_saida)
        else:
            messagebox.showwarning(
                "Planilha nao encontrada",
                "A planilha de resultado nao esta disponivel.",
            )


def main() -> None:
    raiz = tk.Tk()
    ConferenciaApp(raiz)
    raiz.mainloop()


if __name__ == "__main__":
    main()
