        self.botao_selecionar_excel.pack(side="left", padx=(10, 0))

        self.botao_processar = ttk.Button(
            quadro,
            text="Conferir guias",
            command=self.iniciar_processamento,
        )
        self.botao_processar.pack(anchor="w", pady=(0, 16))

