            linha_pdfs,
            text="Selecionar pasta",
            command=self.selecionar_pasta_pdfs,
        )
        self.botao_selecionar_pdfs.pack(side="left", padx=(10, 0))

        ttk.Label(quadro, text="Pasta do arquivo Excel Apuracao-RET:").pack(anchor="w")
        linha_excel = ttk.Frame(quadro)
        linha_excel.pack(fill="x", pady=(5, 15))

        ttk.Entry(linha_excel, textvariable=self.pasta_excel).pack(
            side="left",
            fill="x",
            expand=True,
        )

        self.botao_selecionar_excel = ttk.Button(
            linha_excel,
            text="Selecionar pasta",
            command=self.selecionar_pasta_excel,
