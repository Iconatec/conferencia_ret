def caminho_recurso(nome_arquivo: str) -> Path:
    """Localiza recursos no .py e no executavel PyInstaller --onefile."""
    if getattr(sys, "frozen", False):
        return Path(sys._MEIPASS) / nome_arquivo
    return Path(__file__).resolve().parent / nome_arquivo


def aplicar_icone_janela(janela: tk.Tk) -> None:
    caminho_icone = caminho_recurso("icone.ico")
    if caminho_icone.exists():
        try:
            janela.iconbitmap(str(caminho_icone))
        except tk.TclError:
            pass


